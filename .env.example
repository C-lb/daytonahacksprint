# ============================================================
# Daytona HackSprint — Aggregator stack (TEMPLATE, safe to commit)
#
# SETUP:  cp .env.example .env   then fill in your OWN keys.
# .env is git-ignored — your secrets never get committed or shared.
#
# Base URLs / model / ports below are shared config (not secret) — leave as-is.
# Fill every blank marked <...>. Multi-key fallback: add KEY_2, KEY_3 ... to
# rotate when a key's credits die (402/429).
# ============================================================

# --- Kimi (brain / LLM) — accessed via ai&, NO separate key ---
# Kimi runs on ai&'s gateway. Choose it with AI_AND_MODEL below.

# --- Oxylabs (perception / data) — Residential Proxy ---------
# Route requests THROUGH this proxy. Geo-target via -cc-XX on the username.
OXYLABS_PROXY_HOST=pr.oxylabs.io
OXYLABS_PROXY_PORT=7777
OXYLABS_USERNAME=<your-oxylabs-username>
OXYLABS_PASSWORD=<your-oxylabs-password>
OXYLABS_COUNTRY=US
OXYLABS_USERNAME_2=
OXYLABS_PASSWORD_2=

# --- Daytona (runtime / action) — sandbox execution ----------
DAYTONA_API_KEY=<your-daytona-key>
DAYTONA_API_KEY_2=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# --- ai& (BRAIN + sovereign compute) — Japan, OpenAI-compat --
# Serves open models incl. Kimi. Pick the model by ID (see options below):
#   moonshotai/kimi-k2.7-code | zai-org/glm-5.2 | deepseek-ai/deepseek-v4-flash
#   deepseek-ai/deepseek-v4-pro | qwen/qwen3.6-27b (free) | google/gemma-4-31b-it
AI_AND_API_KEY=<your-aiand-key>
AI_AND_API_KEY_2=
AI_AND_BASE_URL=https://api.aiand.com/v1
# default = fast general model. kimi-k2.7-code is a heavy reasoner — select per
# call with model="moonshotai/kimi-k2.7-code" + large max_tokens.
AI_AND_MODEL=deepseek-ai/deepseek-v4-flash

# --- Nosana (decentralised GPU scale) ------------------------
# Nosana `nos_` API key from the GPU cloud dashboard.
NOSANA_PRIVATE_KEY=<your-nosana-key>
NOSANA_ENDPOINT=

# --- Doubleword (orchestration / inference control) — OpenAI-compat gateway
DOUBLEWORD_API_KEY=<your-doubleword-key>
DOUBLEWORD_API_KEY_2=
DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1
