# Copy to .env and fill with YOUR OWN keys. .env is gitignored — never commit real keys.
# Each collaborator keeps their own .env.

# --- ai& (aiand) --- OpenAI-compatible; also Anthropic-compatible at /v1/messages
AIAND_API_KEY=
AIAND_BASE_URL=https://api.aiand.com/v1
AIAND_MODEL=moonshotai/kimi-k2.7-code

# --- Kimi (Moonshot) --- direct key (prize judging names "Kimi AI"); OpenAI-compatible
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=

# --- Daytona --- sandbox runtime
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# --- Nosana --- decentralized GPU (deployment/job API, not chat)
NOSANA_API_KEY=
NOSANA_BASE_URL=https://dashboard.k8s.prd.nos.ci/api
NOSANA_WALLET=

# --- Oxylabs --- residential proxy for scraping
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_PROXY=pr.oxylabs.io:7777
