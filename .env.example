# Copy to .env and fill with YOUR OWN keys. .env is gitignored — never commit real keys.
# Each collaborator keeps their own .env. Canonical naming (used by src/*.mjs).
# Multi-key fallback: add *_API_KEY_2 to rotate when a key's credits die (402/429).

# --- ai& (aiand) --- BRAIN + sovereign compute. OpenAI-compatible (also /v1/messages Anthropic).
# Serves Kimi, GLM, DeepSeek, Qwen, Gemma. GOTCHA: behind Cloudflare — send a browser
# User-Agent or it 403s (error 1010). Default model = fast/reliable; kimi-k2.7-code is a
# heavy reasoner that needs large max_tokens or it returns empty content.
AIAND_API_KEY=
AIAND_API_KEY_2=
AIAND_BASE_URL=https://api.aiand.com/v1
# Fast/reliable default. NOTE: ai&-hosted kimi-k2.7-code degenerates on short-budget
# chat — use a DIRECT Kimi key for Kimi reasoning, or give it a large max_tokens.
AIAND_MODEL=deepseek-ai/deepseek-v4-flash

# --- Kimi (Moonshot) --- OPTIONAL direct key (judging names "Kimi AI"); OpenAI-compatible.
# Or just call Kimi via ai&: AIAND_MODEL=moonshotai/kimi-k2.7-code (no separate key).
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.7-code

# --- Daytona --- sandbox runtime (execute AI-generated code)
DAYTONA_API_KEY=
DAYTONA_API_KEY_2=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# --- Nosana --- decentralized GPU (job/deployment API, not chat). Bearer nos_ key.
NOSANA_API_KEY=
NOSANA_BASE_URL=https://dashboard.k8s.prd.nos.ci/api
NOSANA_WALLET=

# --- Oxylabs --- residential proxy for scraping. Geo-target via -cc-XX on username.
# Port 7777 may be blocked on some networks (use hotspot / Web Scraper API over 443).
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_PROXY=pr.oxylabs.io:7777
OXYLABS_COUNTRY=US

# --- Doubleword --- OPTIONAL orchestration / inference-control gateway (OpenAI-compatible)
DOUBLEWORD_API_KEY=
DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1
